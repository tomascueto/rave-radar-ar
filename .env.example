# Base de datos PostgreSQL
DATABASE_URL=postgresql://rave_radar:rave_radar_pass@localhost:5432/rave_radar_db

# Qdrant (local: http://localhost:6333 sin API key -- Cloud: URL del cluster + API key)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Gemini -- embeddings (gemini-embedding-001) y generacion de texto del chat
GEMINI_API_KEY=
# Modelo que redacta la respuesta del chat. Opcional -- default: gemini-2.5-flash
GEMINI_GEN_MODEL=gemini-2.5-flash

# Auth
JWT_SECRET_KEY=cambiar-por-un-secreto-random-largo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# URL publica del frontend -- arma los links de los mails (reset de
# password, verificacion) y el redirect final del login con Google.
# Tambien habilita ese origen en CORS (ademas de localhost:5173, siempre
# permitido). En produccion: la URL real del frontend desplegado.
FRONTEND_URL=http://localhost:5173

# Cookies de sesion. Default = comportamiento local (http, mismo origen).
# En produccion, si el frontend y el backend quedan en dominios distintos,
# hace falta samesite=none + secure=true para que el navegador las mande.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# SendGrid -- mails de verificacion y reset de password
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=